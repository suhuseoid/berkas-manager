{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dokumen",
  "version": "0.1.0",
  "identifier": "id.suhu.lemari",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Dokumen", "width": 1040, "height": 700, "minWidth": 760, "minHeight": 500, "dragDropEnabled": true }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Dokumen",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
